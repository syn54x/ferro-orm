{
  "components": {
    "schemas": {
      "ErrorBody": {
        "description": "The one error body both adapters send.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PlayerCreate": {
        "properties": {
          "handle": {
            "maxLength": 40,
            "minLength": 2,
            "title": "Handle",
            "type": "string"
          },
          "rating": {
            "default": 0,
            "minimum": 0.0,
            "title": "Rating",
            "type": "integer"
          },
          "team": {
            "default": "free agents",
            "title": "Team",
            "type": "string"
          }
        },
        "required": [
          "handle"
        ],
        "title": "PlayerCreate",
        "type": "object"
      },
      "PlayerRead": {
        "properties": {
          "handle": {
            "title": "Handle",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "rating": {
            "title": "Rating",
            "type": "integer"
          },
          "team": {
            "title": "Team",
            "type": "string"
          }
        },
        "required": [
          "id",
          "handle",
          "rating",
          "team"
        ],
        "title": "PlayerRead",
        "type": "object"
      },
      "PlayerUpdate": {
        "properties": {
          "handle": {
            "anyOf": [
              {
                "maxLength": 40,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handle"
          },
          "rating": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "team": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team"
          }
        },
        "title": "PlayerUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Players",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/players": {
      "get": {
        "operationId": "list_players",
        "parameters": [
          {
            "description": "Only rows whose team equals this.",
            "in": "query",
            "name": "team",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only rows whose team equals this.",
              "title": "Team"
            }
          },
          {
            "description": "Only rows whose rating equals this.",
            "in": "query",
            "name": "rating",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only rows whose rating equals this.",
              "title": "Rating"
            }
          },
          {
            "description": "The most rows to return.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "The most rows to return.",
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PlayerRead"
                  },
                  "title": "Response List Players",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List players",
        "tags": [
          "players"
        ]
      },
